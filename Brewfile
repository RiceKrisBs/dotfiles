# Homebrew dependencies for this dotfiles setup.
# Install/update everything with: brew bundle --file=Brewfile
# (install.sh runs this automatically.)

# Terminal
cask "ghostty"

# Prompt
brew "powerlevel10k"
cask "font-meslo-lg-nerd-font" # Nerd Font for prompt glyphs

# Workflow
cask "alt-tab"
cask "rectangle"

# Editor
brew "neovim"
brew "ripgrep"
brew "fd"
brew "tree-sitter-cli"
brew "ruff"
brew "fnm"

# Tools
cask "bruno"
brew "coralogix/tap/cx"
cask "dbeaver-community"
brew "glab"

# Utils
brew "jq"
brew "yq"
