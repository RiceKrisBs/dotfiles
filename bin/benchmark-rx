#!/bin/bash
# Benchmarks two rx binaries by running each 50 times and comparing average wall time.
# Usage: benchmark-rx <subcommand...>
# Example: benchmark-rx dev up
#          benchmark-rx cd status
set -euo pipefail

if [ $# -eq 0 ]; then
  echo "Usage: $0 <subcommand...>"
  echo "Example: $0 dev up"
  echo "         $0 cd status"
  exit 1
fi

SUBCMD="$*"
SUBCMD_SLUG="${SUBCMD// /_}"
RUNS=50
DELAY=1
CMD_BEFORE="${RX_BEFORE:-/opt/fullscript/bin/rx}"
CMD_AFTER="${RX_AFTER:-$HOME/src/git.fullscript.io/devops/rx/public/darwin_arm64/rx}"
RESULTS_DIR="${TMPDIR:-/tmp}/rx-bench"
mkdir -p "$RESULTS_DIR"
RESULTS_BEFORE="$RESULTS_DIR/benchmark_${SUBCMD_SLUG}_before.csv"
RESULTS_AFTER="$RESULTS_DIR/benchmark_${SUBCMD_SLUG}_after.csv"

ts() {
  perl -MTime::HiRes=time -e 'printf "%.6f\n", time()'
}

run_benchmark() {
  local label="$1"
  local cmd="$2"
  local outfile="$3"

  echo "=== Benchmarking: $label ==="
  echo "Command: $cmd $SUBCMD"
  echo "Runs: $RUNS (+ 1 warmup)"
  echo ""

  echo "  Warmup run... (discarded)"
  $cmd $SUBCMD >/dev/null 2>&1
  sleep "$DELAY"

  > "$outfile"

  for i in $(seq 1 "$RUNS"); do
    start=$(ts)
    $cmd $SUBCMD >/dev/null 2>&1
    end=$(ts)
    elapsed=$(perl -e "printf '%.6f', $end - $start")
    echo "$elapsed" >> "$outfile"
    printf "  Run %2d/%d: %ss\n" "$i" "$RUNS" "$elapsed"
    if [ "$i" -lt "$RUNS" ]; then
      sleep "$DELAY"
    fi
  done

  echo ""
}

echo "Starting benchmark at $(date)"
echo "Subcommand: rx $SUBCMD"
echo ""

run_benchmark "Before: $CMD_BEFORE" "$CMD_BEFORE" "$RESULTS_BEFORE"
run_benchmark "After: $CMD_AFTER" "$CMD_AFTER" "$RESULTS_AFTER"

echo ""
echo "Raw data saved to: $RESULTS_BEFORE, $RESULTS_AFTER"
echo ""

# Print markdown table
perl -e '
  sub percentile {
    my ($sorted, $p) = @_;
    my $n = scalar @$sorted;
    my $idx = ($p / 100) * ($n - 1);
    my $lo = int($idx);
    my $hi = $lo + 1;
    $hi = $lo if $hi >= $n;
    my $frac = $idx - $lo;
    return $sorted->[$lo] * (1 - $frac) + $sorted->[$hi] * $frac;
  }

  sub load {
    my $f = shift;
    open my $fh, "<", $f or die "Cannot open $f: $!";
    my @vals;
    while (<$fh>) { chomp; push @vals, $_ + 0 if /\S/; }
    return \@vals;
  }

  sub stats {
    my $vals = shift;
    my $n = scalar @$vals;
    my $sum = 0; $sum += $_ for @$vals;
    my $mean = $sum / $n;
    my @sorted = sort { $a <=> $b } @$vals;
    my $min = $sorted[0];
    my $max = $sorted[-1];
    my $var = 0; $var += ($_ - $mean)**2 for @$vals; $var /= $n;
    my $stddev = sqrt($var);
    return {
      n      => $n,
      mean   => $mean,
      min    => $min,
      p50    => percentile(\@sorted, 50),
      p75    => percentile(\@sorted, 75),
      p90    => percentile(\@sorted, 90),
      p95    => percentile(\@sorted, 95),
      p99    => percentile(\@sorted, 99),
      max    => $max,
      stddev => $stddev,
    };
  }

  my ($file_before, $file_after, $subcmd) = @ARGV;
  my $before = stats(load($file_before));
  my $after  = stats(load($file_after));

  my $diff = $after->{mean} - $before->{mean};
  my $pct  = ($diff / $before->{mean}) * 100;
  my $diff_str = sprintf "%+.3fs (%+.1f%%)", $diff, $pct;
  my $verdict;
  if ($pct > 0) {
    $verdict = sprintf "Before is faster by %.1f%%", abs($pct);
  } elsif ($pct < 0) {
    $verdict = sprintf "After is faster by %.1f%%", abs($pct);
  } else {
    $verdict = "No measurable difference";
  }

  printf "### \`rx %s\` Benchmark Results (%d runs each)\n\n", $subcmd, $before->{n};
  printf "| Metric | Before | After | Difference |\n";
  printf "|--------|-------:|------:|-----------:|\n";

  my @metrics = (
    ["Mean",   "mean"],
    ["Min",    "min"],
    ["p50",    "p50"],
    ["p75",    "p75"],
    ["p90",    "p90"],
    ["p95",    "p95"],
    ["p99",    "p99"],
    ["Max",    "max"],
    ["Stddev", "stddev"],
  );

  my $sd_diff = $after->{stddev} - $before->{stddev};
  my $sd_pct  = $before->{stddev} > 0 ? ($sd_diff / $before->{stddev}) * 100 : 0;
  my $sd_diff_str = sprintf "%+.3fs (%+.1f%%)", $sd_diff, $sd_pct;

  for my $m (@metrics) {
    my ($label, $key) = @$m;
    my $diff_col = $label eq "Mean"   ? $diff_str
                 : $label eq "Stddev" ? $sd_diff_str
                 : "";
    printf "| %-6s | %.3fs | %.3fs | %s |\n",
      $label, $before->{$key}, $after->{$key}, $diff_col;
  }

  printf "\n**%s**\n", $verdict;
' "$RESULTS_BEFORE" "$RESULTS_AFTER" "$SUBCMD"
