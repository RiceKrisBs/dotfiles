#!/bin/bash
# Benchmarks two rx binaries with hyperfine, using counterbalanced blocks
# (AB, BA, AB, BA) so time-correlated drift cancels instead of landing on
# one binary. Each block warms both binaries before measuring.
# Usage: benchmark-rx <subcommand...>
# Example: benchmark-rx dev up
#          benchmark-rx cd status
set -euo pipefail

if [ $# -eq 0 ]; then
  echo "Usage: $0 <subcommand...>"
  echo "Example: $0 dev up"
  echo "         $0 cd status"
  exit 1
fi

CMD_BEFORE="${RX_BEFORE:-/opt/fullscript/bin/rx}"
CMD_AFTER="${RX_AFTER:-$HOME/src/git.fullscript.io/devops/rx/public/darwin_arm64/rx}"
BLOCKS="${RX_BENCH_BLOCKS:-4}"
RUNS_PER_BLOCK="${RX_BENCH_RUNS:-12}"
WARMUP="${RX_BENCH_WARMUP:-2}"

for cmd in "$CMD_BEFORE" "$CMD_AFTER"; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "Error: binary not found or not executable: $cmd" >&2
    exit 1
  fi
done

SUBCMD_SLUG=$(printf '%s' "$*" | tr -c 'A-Za-z0-9_-' '_')
RESULTS_DIR="${TMPDIR:-/tmp}/rx-bench/$SUBCMD_SLUG"
rm -rf "$RESULTS_DIR"
mkdir -p "$RESULTS_DIR"

quoted() {
  printf '%q ' "$@"
}
BEFORE_CMDLINE=$(quoted "$CMD_BEFORE" "$@")
AFTER_CMDLINE=$(quoted "$CMD_AFTER" "$@")

echo "Starting benchmark at $(date)"
echo "Subcommand: rx $*"
echo "Before: $CMD_BEFORE"
echo "After:  $CMD_AFTER"
echo "Plan: $BLOCKS blocks x ($WARMUP warmup + $RUNS_PER_BLOCK runs) per binary, alternating AB/BA order"
echo ""

for block in $(seq 1 "$BLOCKS"); do
  json="$RESULTS_DIR/block_$block.json"
  echo "=== Block $block/$BLOCKS ==="
  if [ $((block % 2)) -eq 1 ]; then
    hyperfine -N --warmup "$WARMUP" --runs "$RUNS_PER_BLOCK" --export-json "$json" \
      -n before "$BEFORE_CMDLINE" -n after "$AFTER_CMDLINE"
  else
    hyperfine -N --warmup "$WARMUP" --runs "$RUNS_PER_BLOCK" --export-json "$json" \
      -n after "$AFTER_CMDLINE" -n before "$BEFORE_CMDLINE"
  fi
  echo ""
done

echo "Raw data saved to: $RESULTS_DIR"
echo ""

perl -MJSON::PP -e '
  my $subcmd = shift @ARGV;
  my %times;
  for my $file (@ARGV) {
    open my $fh, "<", $file or die "Cannot open $file: $!";
    local $/;
    my $data = JSON::PP->new->decode(<$fh>);
    push @{ $times{ $_->{command} } }, @{ $_->{times} } for @{ $data->{results} };
  }

  sub percentile {
    my ($sorted, $p) = @_;
    my $idx = ($p / 100) * ($#$sorted);
    my ($lo, $frac) = (int($idx), $idx - int($idx));
    my $hi = $lo + 1 > $#$sorted ? $lo : $lo + 1;
    return $sorted->[$lo] * (1 - $frac) + $sorted->[$hi] * $frac;
  }

  sub stats {
    my $vals = shift;
    my $n = scalar @$vals;
    my $sum = 0; $sum += $_ for @$vals;
    my $mean = $sum / $n;
    my @sorted = sort { $a <=> $b } @$vals;
    my $var = 0; $var += ($_ - $mean)**2 for @$vals;
    $var /= ($n - 1);
    return {
      n      => $n,
      mean   => $mean,
      min    => $sorted[0],
      p50    => percentile(\@sorted, 50),
      p75    => percentile(\@sorted, 75),
      p90    => percentile(\@sorted, 90),
      p95    => percentile(\@sorted, 95),
      max    => $sorted[-1],
      stddev => sqrt($var),
    };
  }

  my $before = stats($times{before});
  my $after  = stats($times{after});

  my $diff = $after->{mean} - $before->{mean};
  my $pct  = ($diff / $before->{mean}) * 100;
  my $diff_str = sprintf "%+.3fs (%+.1f%%)", $diff, $pct;

  my $sd_diff = $after->{stddev} - $before->{stddev};
  my $sd_pct  = $before->{stddev} > 0 ? ($sd_diff / $before->{stddev}) * 100 : 0;
  my $sd_diff_str = sprintf "%+.3fs (%+.1f%%)", $sd_diff, $sd_pct;

  # Two-sample significance gate: |diff| must exceed ~2 combined standard errors.
  my $se = sqrt($before->{stddev}**2 / $before->{n} + $after->{stddev}**2 / $after->{n});
  my $verdict;
  if (abs($diff) < 2 * $se) {
    $verdict = sprintf "No significant difference (%.1f%% is within noise; need >%.1f%%)",
      abs($pct), (2 * $se / $before->{mean}) * 100;
  } elsif ($diff > 0) {
    $verdict = sprintf "Before is faster by %.1f%%", abs($pct);
  } else {
    $verdict = sprintf "After is faster by %.1f%%", abs($pct);
  }

  printf "### \`rx %s\` Benchmark Results (%d runs each)\n\n", $subcmd, $before->{n};
  printf "| Metric | Before | After | Difference |\n";
  printf "|--------|-------:|------:|-----------:|\n";

  for my $m (["Mean", $diff_str], ["Min", ""], ["p50", ""], ["p75", ""],
             ["p90", ""], ["p95", ""], ["Max", ""], ["Stddev", $sd_diff_str]) {
    my ($label, $diff_col) = @$m;
    my $key = lc $label;
    printf "| %-6s | %.3fs | %.3fs | %s |\n",
      $label, $before->{$key}, $after->{$key}, $diff_col;
  }

  printf "\n**%s**\n", $verdict;
' "$*" "$RESULTS_DIR"/block_*.json
